//vars.put(&quot;cred&quot;,cred.toString());

import java.util.concurrent.ThreadLocalRandom

def value = ThreadLocalRandom.current().nextInt(10000, 100000)

def cred = ThreadLocalRandom.current().nextLong(111111111111111L, 1000000000000000L)

vars.put(&quot;value&quot;, value.toString())
vars.put(&quot;cred&quot;, cred.toString())</stringProp>
